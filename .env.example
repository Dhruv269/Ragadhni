# ==============================================================================
# Ragadhni — Environment Variables Template (`.env.example`)
# ==============================================================================
#
# WHAT THIS FILE DOES:
# This file is an example template showing all the environment variables and
# secret keys the Ragadhni application uses to connect to databases, payment gateways,
# and shipping providers.
#
# WHY IT EXISTS:
# In web development, you NEVER write real passwords, database credentials,
# or secret API keys into your code or commit them to Git.
# If you commit secrets to GitHub, hackers can steal your database and funds.
# Instead, you create a private file named `.env.local` on your computer (which is
# ignored by Git in `.gitignore`) and copy the variables below into it.
#
# IMPORTANT DISTINCTION (NEXT_PUBLIC_ vs BACKEND SECRETS):
# 1. Variables starting with `NEXT_PUBLIC_`:
#    - Next.js bundles these into the frontend JavaScript.
#    - They ARE visible to shoppers in the browser (e.g., your Razorpay public key ID).
# 2. Variables WITHOUT `NEXT_PUBLIC_`:
#    - Kept strictly on the server (Node.js).
#    - Hackers and shoppers CANNOT see them (e.g., `DATABASE_URL`, `RAZORPAY_KEY_SECRET`).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION HOSTING
# ------------------------------------------------------------------------------
# The base URL where the website is running (localhost:3000 during local development)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Canonical URL used by NextAuth to handle authentication callbacks
NEXTAUTH_URL="http://localhost:3000"

# Random secret key used to encrypt customer session tokens and cookies
NEXTAUTH_SECRET="ragadhni_dev_session_secret_change_in_production"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL (Neon Serverless, Supabase, AWS RDS, or Docker)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]?schema=public
DATABASE_URL="postgresql://username:password@localhost:5432/ragadhni_db?schema=public"

# ------------------------------------------------------------------------------
# 3. INDIAN PAYMENT GATEWAY (Razorpay Sandbox)
# ------------------------------------------------------------------------------
# Public Key ID: Shared with the customer's browser to open the UPI/Card payment modal
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"

# Private Key Secret: Stored ONLY on the server to verify payments
RAZORPAY_KEY_SECRET="placeholder_secret"

# Webhook Secret: Used to cryptographically verify payment notifications sent from Razorpay
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# ------------------------------------------------------------------------------
# 4. INDIAN LOGISTICS & SHIPPING (Shiprocket Sandbox)
# ------------------------------------------------------------------------------
# API account email for generating courier labels and checking pincodes
SHIPROCKET_API_EMAIL="logistics@ragadhni.com"

# API password
SHIPROCKET_API_PASSWORD="placeholder_password"

# Secret token used to verify real-time tracking webhooks sent by courier partner
SHIPROCKET_WEBHOOK_TOKEN="placeholder_token"

# ------------------------------------------------------------------------------
# 5. CLOUD MEDIA & IMAGE HOSTING (Cloudinary / AWS S3)
# ------------------------------------------------------------------------------
# Cloud storage credentials for uploading high-resolution clothing photography
CLOUDINARY_CLOUD_NAME="ragadhni-media"
CLOUDINARY_API_KEY="placeholder_key"
CLOUDINARY_API_SECRET="placeholder_secret"
